<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PurduePasta.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="PurdueGold">#CFB991</Color>
            <Color x:Key="PurdueBlack">#171717</Color>
            <Color x:Key="Ink">#252525</Color>
            <Color x:Key="MutedInk">#6F6F6F</Color>
            <Color x:Key="Canvas">#F7F5F0</Color>
            <Color x:Key="Card">#FFFFFF</Color>
            <Color x:Key="Success">#2F7D5B</Color>
            <Style TargetType="ContentPage">
                <Setter Property="BackgroundColor" Value="{StaticResource Canvas}" />
                <Setter Property="Padding" Value="0" />
            </Style>
            <Style x:Key="EyebrowLabel" TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource PurdueBlack}" />
                <Setter Property="CharacterSpacing" Value="1.5" />
            </Style>
            <Style x:Key="PageTitle" TargetType="Label">
                <Setter Property="FontSize" Value="30" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource Ink}" />
            </Style>
            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource Card}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="StrokeShape" Value="RoundRectangle 18" />
            </Style>
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource PurdueBlack}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="HeightRequest" Value="52" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
